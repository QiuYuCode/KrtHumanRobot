          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edgeVoiceDialog" value="recognized command" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block" edge="1" parent="coreGroup" source="voiceBehaviors" target="dialogTree">
