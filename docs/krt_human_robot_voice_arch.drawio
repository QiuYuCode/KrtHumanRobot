<mxfile host="app.diagrams.net">
  <diagram id="krt-human-robot-voice-arch" name="KrtHumanRobot Voice Architecture">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="KrtHumanRobot core behavior tree and voice stack responsibilities" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="250" y="30" width="1080" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="user" value="User speech" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16" vertex="1" parent="1">
          <mxGeometry x="70" y="180" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="voiceStackGroup" value="voice_assistant / voice_stack&#xa;voice-only subsystem" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;fontStyle=1;startSize=40" vertex="1" parent="1">
          <mxGeometry x="300" y="100" width="430" height="430" as="geometry"/>
        </mxCell>
        <mxCell id="audioCapture" value="voice_audio_capture&#xa;microphone capture&#xa;/voice/audio/raw" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="voiceStackGroup">
          <mxGeometry x="30" y="70" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="kws" value="voice_kws&#xa;wake word events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="voiceStackGroup">
          <mxGeometry x="230" y="70" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="vad" value="voice_audio_process&#xa;VAD events&#xa;/voice/vad/events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="voiceStackGroup">
          <mxGeometry x="30" y="180" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="asr" value="voice_asr&#xa;speech recognition&#xa;/voice/asr/recognize&#xa;/voice/asr/stream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="voiceStackGroup">
          <mxGeometry x="230" y="180" width="170" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="tts" value="voice_tts + playback&#xa;synthesize and speak&#xa;/voice/tts/synthesize&#xa;/voice/playback/stop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="voiceStackGroup">
          <mxGeometry x="120" y="320" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="coreGroup" value="krt_human_robot&#xa;core robot behavior entry" style="swimlane;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;startSize=40" vertex="1" parent="1">
          <mxGeometry x="810" y="100" width="520" height="520" as="geometry"/>
        </mxCell>
        <mxCell id="launch" value="robot.launch.py&#xa;default: starts voice stack&#xa;then starts krtHumanRobot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="coreGroup">
          <mxGeometry x="30" y="65" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="coreNode" value="krtHumanRobot node&#xa;owns py_trees runtime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="coreGroup">
          <mxGeometry x="290" y="65" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="voiceBehaviors" value="voice adapter behaviors&#xa;WaitForWakeWord&#xa;ListenCommand&#xa;SpeakResponse&#xa;WakeWordInterruptMonitor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="coreGroup">
          <mxGeometry x="30" y="200" width="210" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="dialogTree" value="dialog behavior tree&#xa;blackboard init&#xa;intent recognition / planner&#xa;action selector / executor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="coreGroup">
          <mxGeometry x="280" y="200" width="210" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="robotActions" value="robot actions&#xa;gripper&#xa;robot arm&#xa;navigation&#xa;LLM dialog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="coreGroup">
          <mxGeometry x="155" y="370" width="210" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="visionDisabled" value="vision/camera intents&#xa;currently disabled&#xa;future /krtHumanRobot/... design" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1" vertex="1" parent="coreGroup">
          <mxGeometry x="30" y="370" width="110" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="actuators" value="Robot subsystems&#xa;arms / grippers / nav / future camera" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16" vertex="1" parent="1">
          <mxGeometry x="1390" y="310" width="170" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="edgeUserAudio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2" edge="1" parent="1" source="user" target="audioCapture">
          <mxGeometry relative="1" as="geometry"/>
