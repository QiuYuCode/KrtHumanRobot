        <mxCell id="edgeActionsActuators" value="ROS calls / SDK calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2" edge="1" parent="1" source="robotActions" target="actuators">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="Boundary: voice stack produces/consumes /voice/...; core tree owns dialog state and robot action decisions. Camera is deliberately not designed here yet." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14" vertex="1" parent="1">
