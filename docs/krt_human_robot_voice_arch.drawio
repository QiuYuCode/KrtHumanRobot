        <mxCell id="edgeDialogActions" value="intent / plan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block" edge="1" parent="coreGroup" source="dialogTree" target="robotActions">
