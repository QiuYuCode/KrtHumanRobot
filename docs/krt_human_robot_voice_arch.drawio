        <mxCell id="edgeDialogVision" value="camera intent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;dashed=1" edge="1" parent="coreGroup" source="dialogTree" target="visionDisabled">
          <mxGeometry relative="1" as="geometry"/>
