ROS_DOMAIN_ID=42
ROS_LOCALHOST_ONLY=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
CYCLONEDDS_URI=file:///home/create/WorkSpace/KrtHumanRobot/deploy/cyclonedds/x86.xml
KRT_WORKSPACE=/home/create/WorkSpace/KrtHumanRobot
# DexHand SDK source. Defaults to the sibling dexhand_sdk_python directory when unset.
KRT_DEXHAND_SDK_PYTHONPATH=/home/create/WorkSpace/dexhand_sdk_python
KRT_DDS_BIND_ADDRESS=10.168.1.100
KRT_STARTUP_TIMEOUT_S=90
# Start cloud-backed ROS nodes only after NetworkManager reports Internet reachability.
KRT_REQUIRE_GLOBAL_NETWORK=yes
# Optional fail-closed CAN check; leave empty so one failed arm does not block voice.
KRT_CAN_REQUIRED_CHANNELS=
KRT_MAP=/home/create/maps/map.yaml
KRT_PCD_MAP=/home/create/maps/scans.pcd
KRT_WEB_HOST=0.0.0.0
KRT_WEB_PORT=8443
KRT_WEB_CERTFILE=
KRT_WEB_KEYFILE=
# Quest 遥操作专用 conda 环境。必须包含 pinocchio（含 casadi）和 pure-python-adb。
KRT_QUEST_VT_BIN=/home/create/miniconda3/envs/vt/bin
# Show Quest pose and both arm RViz windows on the local X11 desktop.
KRT_QUEST_RVIZ=true
# Optional local desktop overrides for RViz. The service auto-detects an active
# local X11 session when these are empty or stale.
KRT_RVIZ_DISPLAY=
KRT_RVIZ_XAUTHORITY=
LLM_API_KEY=
VLM_API_KEY=
XFYUN_IAT_APPID=
XFYUN_IAT_API_KEY=
XFYUN_IAT_API_SECRET=
XFYUN_TTS_APPID=
XFYUN_TTS_API_KEY=
XFYUN_TTS_API_SECRET=
