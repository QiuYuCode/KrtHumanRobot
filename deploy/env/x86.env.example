ROS_DOMAIN_ID=42
ROS_LOCALHOST_ONLY=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
CYCLONEDDS_URI=file:///home/create/WorkSpace/KrtHumanRobot/deploy/cyclonedds/x86.xml
KRT_WORKSPACE=/home/create/WorkSpace/KrtHumanRobot
KRT_DDS_BIND_ADDRESS=10.168.1.100
KRT_STARTUP_TIMEOUT_S=90
# Start cloud-backed ROS nodes only after NetworkManager reports Internet reachability.
KRT_REQUIRE_GLOBAL_NETWORK=yes
# Optional fail-closed CAN check; leave empty so one failed arm does not block voice.
KRT_CAN_REQUIRED_CHANNELS=
KRT_MAP=/home/create/maps/map.yaml
KRT_PCD_MAP=/home/create/maps/scans.pcd
KRT_WEB_HOST=0.0.0.0
KRT_WEB_PORT=8443
KRT_WEB_CERTFILE=
KRT_WEB_KEYFILE=
LLM_API_KEY=
VLM_API_KEY=
XFYUN_IAT_APPID=
XFYUN_IAT_API_KEY=
XFYUN_IAT_API_SECRET=
XFYUN_TTS_APPID=
XFYUN_TTS_API_KEY=
XFYUN_TTS_API_SECRET=
