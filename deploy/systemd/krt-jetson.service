[Unit]
Description=KrtHumanRobot Jetson camera stack
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=%h/.config/krt/jetson.env
WorkingDirectory=%h/WorkSpace/KrtHumanRobot
ExecStartPre=/bin/bash -lc 'exec /bin/bash "$KRT_WORKSPACE/deploy/systemd/krt-wait-ready.sh" jetson'
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && source "$KRT_WORKSPACE/install/setup.bash" && exec ros2 launch hand_camera_driver jetson_cameras.launch.py'
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=default.target
